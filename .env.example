# Ключ AssemblyAI (https://www.assemblyai.com/dashboard)
ASSEMBLYAI_API_KEY=
# Пароль для входа в веб-интерфейс
APP_PASSWORD=change-me
# Секрет для подписи cookie (python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=
# Куда складывать файлы и БД
DATA_DIR=./data
# Максимальный размер одного файла, МБ
MAX_UPLOAD_MB=500
# Сколько файлов обрабатывать параллельно
WORKERS=2
# Модели распознавания через запятую (см. актуальную доку AssemblyAI)
SPEECH_MODELS=universal-3-pro,universal-2
# Cookie только по HTTPS (true, если стоит за HTTPS)
COOKIE_SECURE=false
# Домен для Caddy (docker compose --profile https)
DOMAIN=
